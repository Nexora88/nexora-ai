# ======================
# Nexora AI - Environment
# ======================

APP_NAME=Nexora AI
ENVIRONMENT=development
DEBUG=true

# Database
# Local: leave empty to use SQLite automatically.
# Production/Vercel: REQUIRED persistent PostgreSQL URL.
DATABASE_URL=

# Auth - NEVER use placeholder values in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Free / Paid LLM Providers
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# Limits
FREE_MESSAGES_LIMIT=5
PRO_MESSAGES_LIMIT=400
ELITE_MESSAGES_LIMIT=2000
