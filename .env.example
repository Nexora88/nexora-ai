# ======================
# Nexora AI - Environment
# ======================

APP_NAME=Nexora AI
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-very-long-random-string
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./nexora.db

# Auth
JWT_SECRET=change-this-jwt-secret-to-something-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Free / Paid LLM Providers
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# Limits
FREE_MESSAGES_LIMIT=5
PRO_MESSAGES_LIMIT=400
ELITE_MESSAGES_LIMIT=2000
