# Nexora AI — production-safe environment template
# IMPORTANT: Bu dosyaya gerçek anahtar/şifre YAZMA.
# Gerçek değerleri yalnızca sunucunun Environment Variables bölümüne gir.

APP_NAME=Nexora AI
ENVIRONMENT=production
DEBUG=false

# Persistent database (production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Authentication / JWT
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM providers — yalnız kullandıklarını doldur
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
ORS_API_KEY=
NASA_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=


# Search / media
TAVILY_API_KEY=
REPLICATE_API_TOKEN=
WEATHER_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# GitHub OAuth / Ship
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://YOUR-BACKEND-DOMAIN/api/v1/ship/callback
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN

# Usage limits
SHIP_TOKEN_COST=10
FREE_MESSAGES_LIMIT=5
PRO_MESSAGES_LIMIT=400
ELITE_MESSAGES_LIMIT=2000
